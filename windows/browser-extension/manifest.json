{
  "manifest_version": 3,
  "name": "OpenMessage Google Login Refresh",
  "version": "0.1.2",
  "description": "Keeps the locally installed OpenMessage connected to Google Messages in this browser profile.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://messages.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Refresh the OpenMessage Google login"
  }
}
